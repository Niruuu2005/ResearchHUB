# ==============================================================================
# ResearchOps AI — Terraform variables (example)
# Copy to terraform.tfvars and fill in your values.
# DO NOT commit terraform.tfvars to Git.
# ==============================================================================

aws_region       = "ap-south-1"
project_name     = "ResearchOpsAI"
instance_type    = "t3.small"              # t3.micro for Free Tier; small+ recommended for full Compose
key_name         = "your-aws-key-pair-name"  # WITHOUT .pem
allowed_ssh_cidr = "0.0.0.0/0"             # Prefer YOUR_PUBLIC_IP/32
