# ==============================================================================
# ResearchLite Ansible Inventory Template
# Copy this file to 'inventory.ini' and update with your EC2 details.
# DO NOT commit 'inventory.ini' containing your actual IP or key paths to Git.
# ==============================================================================

[research_server]
YOUR_EC2_PUBLIC_IP ansible_user=ubuntu ansible_ssh_private_key_file=path/to/your-key.pem ansible_ssh_common_args='-o StrictHostKeyChecking=no'
