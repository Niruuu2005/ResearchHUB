# ==============================================================================
# ResearchOps AI — Ansible inventory (example)
# Copy to inventory.ini and set your EC2 IP + private key path.
# DO NOT commit inventory.ini with real IPs or key paths.
# ==============================================================================

[research_server]
YOUR_EC2_PUBLIC_IP ansible_user=ubuntu ansible_ssh_private_key_file=/path/to/your-key.pem ansible_ssh_common_args='-o StrictHostKeyChecking=no'
