# ResearchLite Environment Configuration (Optional)
# Default values will be used if these are omitted.

# Application Settings
APP_NAME=ResearchLite
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=False

# API Timeouts & Limits (in seconds)
REQUEST_TIMEOUT_SECONDS=10.0
MAX_PAPERS_PER_PROVIDER=5

# Custom User-Agent for Research API requests (Wikipedia & Crossref etiquette)
USER_AGENT=ResearchLite/1.0.0 (https://github.com/example/researchlite; mailto:student@example.edu)
