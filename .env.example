# ResearchOps AI Environment Configuration (Optional)

# Defaults work for local SQLite / zero-setup mode if this file is omitted.

# Application
APP_NAME=ResearchOps AI
APP_VERSION=2.0.0
APP_ENV=development

# Database (leave unset for local SQLite)
# DATABASE_URL=postgresql+psycopg2://researchops:researchops_secret@localhost:5432/researchops

# Redis / Celery (Compose sets these; local default is sync without Celery)
# REDIS_URL=redis://localhost:6379/0
USE_CELERY=false

# Storage
STORAGE_PATH=./data/documents
EXPORT_STORAGE_PATH=./data/exports

# LLM: openai | gemini | ollama | heuristic
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
# Put the real key only in local .env (gitignored) — never commit secrets
# LLM_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings: auto | sentence-transformers | hash
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Research providers
ENABLE_WIKIPEDIA=true
ENABLE_OPENALEX=true
ENABLE_CROSSREF=true
REQUEST_TIMEOUT_SECONDS=10.0
MAX_PAPERS_PER_PROVIDER=5
USER_AGENT=ResearchOpsAI/2.0.0 (https://github.com/Niruuu2005/ResearchHUB; mailto:student@example.edu)
