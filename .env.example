# ResearchOps AI Environment Configuration (Optional)

# Defaults work for local SQLite / zero-setup mode if this file is omitted.

# Application
APP_NAME=ResearchOps AI
APP_VERSION=2.0.0
APP_ENV=development

# Database (leave unset for local SQLite)
# DATABASE_URL=postgresql+psycopg2://researchops:researchops_secret@localhost:5432/researchops

# Google OAuth 2.0 & Session Security (OpenID Connect)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Minimal scopes requested: openid, email, profile
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Public callback URL (must match Authorized Redirect URIs in Google Cloud Console)
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Cryptographic secret key for signing session tokens (32+ random characters)
SESSION_SECRET_KEY=replace-with-a-secure-random-32-byte-secret-key
APP_BASE_URL=http://localhost:8000
# Allow mock developer logins when Google credentials are not configured
ALLOW_MOCK_AUTH=true

# Redis / Celery (Compose sets these; local default is sync without Celery)
# REDIS_URL=redis://localhost:6379/0
USE_CELERY=false

# Storage
STORAGE_PATH=./data/documents
EXPORT_STORAGE_PATH=./data/exports

# LLM: openai | gemini | ollama | heuristic
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
# Put the real key only in local .env (gitignored) — never commit secrets
# LLM_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings: auto | sentence-transformers | hash
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Research providers
ENABLE_WIKIPEDIA=true
ENABLE_OPENALEX=true
ENABLE_CROSSREF=true
REQUEST_TIMEOUT_SECONDS=10.0
MAX_PAPERS_PER_PROVIDER=5
USER_AGENT=ResearchOpsAI/2.0.0 (https://github.com/Niruuu2005/ResearchHUB; mailto:student@example.edu)
