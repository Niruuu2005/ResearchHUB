    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "title": "Active Background Jobs",
      "type": "stat",
      "targets": [
        {
          "expr": "researchops_active_background_jobs",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 5,
      "title": "Database Status",
      "type": "stat",
      "targets": [
        {
          "expr": "researchops_database_healthy",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "color": "red", "index": 0, "text": "DOWN" },
                "1": { "color": "green", "index": 1, "text": "HEALTHY" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 6,
      "title": "Platform Uptime",
      "type": "stat",
      "targets": [
        {
          "expr": "researchops_process_uptime_seconds",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "fixedColor": "#10b981", "mode": "fixed" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#10b981", "value": null }] }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 4 },
      "id": 7,
      "title": "Circuit Breakers (0=CLOSED / 1=HALF-OPEN / 2=OPEN)",
      "type": "stat",
      "targets": [
        {
          "expr": "researchops_circuit_breaker_state",
          "refId": "A",
          "legendFormat": "{{provider}}"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "color": "green", "index": 0, "text": "CLOSED (Normal)" },
                "1": { "color": "yellow", "index": 1, "text": "HALF-OPEN (Probe)" },
                "2": { "color": "red", "index": 2, "text": "OPEN (Tripped)" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 4 },
      "id": 8,
      "title": "HTTP Traffic (Requests Handled)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (method, status) (http_requests_total)",
          "refId": "A",
          "legendFormat": "{{method}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 9,
      "title": "Research Projects",
      "type": "timeseries",
      "targets": [
        {
          "expr": "researchops_total_projects",
          "refId": "A",
          "legendFormat": "projects"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#06b6d4", "mode": "fixed" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 10,
      "title": "Provider Probe Latency (ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "researchops_provider_latency_ms",
          "refId": "A",
          "legendFormat": "{{provider}} ({{status}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      }
    }
